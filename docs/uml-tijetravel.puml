@startuml TijeTravel_Modelo_Web
title Tije Travel - Modelo web

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members

package "com.tijetravel.tijeback.enums" {
    enum RolUsuario
    enum Permiso
    enum ClaseVuelo
    enum TipoHospedaje
}

package "com.tijetravel.tijeback.modelos" {
    abstract class Usuario {
        - codigo: Integer
        - nombreUsuario: String
        - contrasenia: String
        - rol: RolUsuario
        + actualizarCredenciales(nombreUsuario, contrasenia): void
        + tienePermiso(permiso): boolean
    }
    class Administrador
    class Vendedor
    class Cliente
    class Turista {
        - codigo: Integer
        - nombre: String
        - apellido: String
        - direccion: String
        - email: String
        - telefonoFijo: String
        - telefonoCelular: String
        + actualizarDatos(): void
        + isTitular(): boolean
    }
    class Sucursal
    class Hotel
    class Vuelo
    class Reserva
}

Usuario <|-- Administrador
Usuario <|-- Vendedor
Usuario <|-- Cliente
Cliente --> Turista
Turista --> Sucursal : sucursalContratacion
Turista --> Turista : titular
Reserva --> Turista
Reserva --> Sucursal : sucursal historica
Reserva --> Vuelo
Reserva --> Hotel
Reserva --> ClaseVuelo
Reserva --> TipoHospedaje
Usuario --> RolUsuario
Usuario ..> Permiso

@enduml

@startuml TijeTravel_Capas_Web
title Tije Travel - Arquitectura backend

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members

package "api" {
    class SucursalesRestControlador
    class HotelesRestControlador
    class VuelosRestControlador
    class AutenticacionRestControlador
    class TuristasRestControlador
    class ReservasRestControlador
    class UsuariosRestControlador
    class DTOsSolicitudYRespuesta
    class Mapeadores
    class ManejadorGlobalExcepciones
}

package "seguridad" {
    class ConfiguracionSeguridad
    class UsuarioDetallesServicio
    class UsuarioActualServicio
    class UsuarioAutenticado
    class AdministradorInicializador
}

package "servicios.usuarios" {
    class UsuarioFactory
    interface CreadorUsuario
    class CreadorAdministrador
    class CreadorVendedor
    class CreadorCliente
}
UsuarioFactory --> CreadorUsuario : registro por rol
CreadorUsuario <|.. CreadorAdministrador
CreadorUsuario <|.. CreadorVendedor
CreadorUsuario <|.. CreadorCliente
UsuarioServicio --> UsuarioFactory

package "servicios" {
    class SucursalServicio
    class HotelServicio
    class VueloServicio
    class TuristaServicio
    class ReservaServicio
    class UsuarioServicio
    class BloqueoEscrituras
    class OcupacionHotel
    class DisponibilidadServicio
    class AutorizacionServicio
}

package "repositorios" {
    interface JpaRepository
    interface SucursalRepositorio
    interface HotelRepositorio
    interface VueloRepositorio
    interface TuristaRepositorio
    interface ReservaRepositorio
    interface UsuarioRepositorio
}

package "modelos" {
    class Sucursal
    class Hotel
    class Vuelo
    class Turista
    class Reserva
    class Usuario
}

package "excepciones" {
    class ReglaNegocioException
    class EntidadNoEncontradaException
    class EntidadDuplicadaException
    class CapacidadExcedidaException
    class OperacionNoPermitidaException
}

database MySQL
component Flyway

SucursalesRestControlador --> DTOsSolicitudYRespuesta
HotelesRestControlador --> DTOsSolicitudYRespuesta
VuelosRestControlador --> DTOsSolicitudYRespuesta
TuristasRestControlador --> DTOsSolicitudYRespuesta
ReservasRestControlador --> DTOsSolicitudYRespuesta
UsuariosRestControlador --> DTOsSolicitudYRespuesta
SucursalesRestControlador --> Mapeadores
HotelesRestControlador --> Mapeadores
VuelosRestControlador --> Mapeadores
SucursalesRestControlador --> SucursalServicio
HotelesRestControlador --> HotelServicio
VuelosRestControlador --> VueloServicio
AutenticacionRestControlador --> ConfiguracionSeguridad : autentica y crea sesion
SucursalesRestControlador --> UsuarioActualServicio
HotelesRestControlador --> UsuarioActualServicio
VuelosRestControlador --> UsuarioActualServicio
HotelesRestControlador --> DisponibilidadServicio : consulta disponibilidad
VuelosRestControlador --> DisponibilidadServicio : consulta disponibilidad
TuristasRestControlador --> TuristaServicio
ReservasRestControlador --> ReservaServicio
UsuariosRestControlador --> UsuarioServicio
TuristasRestControlador --> UsuarioActualServicio
ReservasRestControlador --> UsuarioActualServicio
UsuariosRestControlador --> UsuarioActualServicio
ManejadorGlobalExcepciones ..> ReglaNegocioException

ConfiguracionSeguridad --> UsuarioDetallesServicio
UsuarioActualServicio --> UsuarioRepositorio
UsuarioDetallesServicio --> UsuarioRepositorio
UsuarioDetallesServicio --> UsuarioAutenticado
AdministradorInicializador --> UsuarioRepositorio

SucursalServicio --> SucursalRepositorio
HotelServicio --> HotelRepositorio
VueloServicio --> VueloRepositorio
TuristaServicio --> TuristaRepositorio
ReservaServicio --> BloqueoEscrituras
    HotelServicio --> BloqueoEscrituras
    VueloServicio --> BloqueoEscrituras
    TuristaServicio --> BloqueoEscrituras
    UsuarioServicio --> BloqueoEscrituras
    SucursalServicio --> BloqueoEscrituras
    HotelServicio --> OcupacionHotel
    DisponibilidadServicio --> OcupacionHotel
    ReservaServicio --> DisponibilidadServicio
DisponibilidadServicio --> ReservaRepositorio
DisponibilidadServicio --> VueloRepositorio
DisponibilidadServicio --> HotelRepositorio
ReservaServicio --> ReservaRepositorio
UsuarioServicio --> UsuarioRepositorio

JpaRepository <|-- SucursalRepositorio
JpaRepository <|-- HotelRepositorio
JpaRepository <|-- VueloRepositorio
JpaRepository <|-- TuristaRepositorio
JpaRepository <|-- ReservaRepositorio
JpaRepository <|-- UsuarioRepositorio

SucursalRepositorio --> Sucursal
HotelRepositorio --> Hotel
VueloRepositorio --> Vuelo
TuristaRepositorio --> Turista
ReservaRepositorio --> Reserva
UsuarioRepositorio --> Usuario
JpaRepository --> MySQL
Flyway --> MySQL : aplica migraciones

ReglaNegocioException <|-- EntidadNoEncontradaException
ReglaNegocioException <|-- EntidadDuplicadaException
ReglaNegocioException <|-- CapacidadExcedidaException
ReglaNegocioException <|-- OperacionNoPermitidaException

@enduml
