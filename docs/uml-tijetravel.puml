    interface HotelServicio
    interface VueloServicio
    interface TuristaServicio
    interface ReservaServicio
    interface UsuarioServicio
    interface DisponibilidadServicio
    interface CiudadServicio
    class BloqueoEscrituras
    class AutorizacionServicio
}

package "servicios.impl" {
    class SucursalServicioImpl
    class HotelServicioImpl
    class VueloServicioImpl
    class TuristaServicioImpl
    class ReservaServicioImpl
    class UsuarioServicioImpl
    class DisponibilidadServicioImpl
    class CiudadServicioImpl
    class FiltrosConsulta
    class OcupacionHotel
    class CiudadConsulta
    class ComparadorCercaniaFecha
}

SucursalServicio <|.. SucursalServicioImpl
HotelServicio <|.. HotelServicioImpl
VueloServicio <|.. VueloServicioImpl
TuristaServicio <|.. TuristaServicioImpl
ReservaServicio <|.. ReservaServicioImpl
UsuarioServicio <|.. UsuarioServicioImpl
DisponibilidadServicio <|.. DisponibilidadServicioImpl
CiudadServicio <|.. CiudadServicioImpl

package "repositorios" {
