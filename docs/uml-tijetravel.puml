@startuml TijeTravel_Modelo_Web
title Tije Travel - Modelo web

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members

package "com.tijetravel.tijeback.enums" {
    enum RolUsuario
    enum Permiso
    enum ClaseVuelo
    enum TipoHospedaje
}

package "com.tijetravel.tijeback.modelos" {
    abstract class Usuario {
        - codigo: Integer
        - nombreUsuario: String
        - contrasenia: String
        - dni: String
        - rol: RolUsuario
        + actualizarCredenciales(nombreUsuario, contrasenia): void
        + {abstract} tienePermiso(permiso): boolean
        + puedeVerTurista(turista): boolean
        + getCodigoGrupoFamiliar(): Integer
        + tieneDniPropio(): boolean
    }
    class Administrador {
        + tienePermiso(permiso): boolean
    }
    class Vendedor {
        + tienePermiso(permiso): boolean
    }
    class Cliente {
        + tienePermiso(permiso): boolean
        + puedeVerTurista(turista): boolean
        + getCodigoGrupoFamiliar(): Integer
        + tieneDniPropio(): boolean
    }
    class Turista {
        - dni: String
        - codigo: Integer
        - nombre: String
        - apellido: String
        - direccion: String
        - email: String
        - telefonoFijo: String
        - telefonoCelular: String
        + actualizarDatos(): void
        + isTitular(): boolean
    }
    class Sucursal
    class Hotel
    class Vuelo
    class Reserva
}

Usuario <|-- Administrador
Usuario <|-- Vendedor
Usuario <|-- Cliente
Cliente --> Turista
Turista --> Sucursal : sucursalContratacion
Turista --> Turista : titular
Reserva --> Turista
Reserva --> Sucursal : sucursal historica
Reserva --> Vuelo
Reserva --> Hotel
Reserva --> ClaseVuelo
Reserva --> TipoHospedaje
Usuario --> RolUsuario
Usuario ..> Permiso

@enduml

@startuml TijeTravel_Capas_Web
title Tije Travel - Arquitectura backend

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members

package "api" {
    class SucursalesRestControlador
    class HotelesRestControlador
    class VuelosRestControlador
    class AutenticacionRestControlador
    class TuristasRestControlador
    class ReservasRestControlador
    class UsuariosRestControlador
    class DTOsSolicitudYRespuesta
    class Mapeadores
    class ManejadorGlobalExcepciones
}

package "seguridad" {
